# Dashboard login (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# ouro-monitor (required in production; leave unset to use built-in demo metrics)
MONITOR_URL=https://monitor.example.com
MONITOR_ADMIN_API_KEY=same-as-monitor-ADMIN_API_KEY

# Server
PORT=8790
# COOKIE_SECURE=1   # required on HTTPS deploys (Secure cookie flag)
